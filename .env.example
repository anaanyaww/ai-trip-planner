# ==============================================================================
# AI Trip Planner - environment configuration
#
# Copy to `.env` and fill in the values marked REQUIRED.
# `.env` is git-ignored and must never be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_ENV=local                       # local | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                  # console (human-readable) | json (structured)
API_HOST=127.0.0.1
API_PORT=8000

# ------------------------------------------------------------------------------
# LLM providers
#
# The failover chain is built from every (provider, key, model) combination, tried in
# order until one answers. Free tiers meter per key AND per model, so when one is
# refused the useful next attempt is a different key or a different model - not only a
# different vendor. Listing more of either makes the system more resilient at no cost.
#
# Providers are tried in the order named here. Within a provider, every key is tried
# against every model before moving on.
# ------------------------------------------------------------------------------
LLM_PROVIDER_CHAIN=openrouter,groq,gemini

# --- Groq --- https://console.groq.com/keys
# Free tier meters tokens per minute (8,000 on `on_demand`), which a long revision
# prompt can exceed outright. A second key is metered separately, so it doubles the
# headroom; leave GROQ_API_KEY_ALT blank if you only have one.
GROQ_API_KEY=
GROQ_API_KEY_ALT=
# Comma-separated, in preference order. gpt-oss binds tools but is unreliable at the
# structured-output calls the agents make, so it sits behind qwen rather than ahead.
GROQ_MODELS=qwen/qwen3.6-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# --- OpenRouter --- https://openrouter.ai/keys
# Aggregates many vendors behind one key, so each `:free` id is served by a different
# upstream with its own limits. The most useful place to list several models.
# The free roster changes without notice; check openrouter.ai/models on a 404.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_ALT=
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free,minimax/minimax-m3:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Google AI Studio --- https://aistudio.google.com/apikey
# Flash and Flash-Lite are the free-tier families; Pro models are paid only.
GOOGLE_API_KEY=
GOOGLE_API_KEY_ALT=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash

# --- Ollama (local, no key, no quota) --- https://ollama.com/download
# Opt in by naming `ollama` in LLM_PROVIDER_CHAIN above. Listing it FIRST with hosted
# providers behind it gives unlimited local capacity that hands over when the local
# model struggles:
#   LLM_PROVIDER_CHAIN=ollama,openrouter,groq,gemini
#
# The agents need tool calling AND structured output, so the model must support tools.
# Pick for your VRAM - a model that does not fit spills to CPU and gets far slower:
#   4 GB VRAM  -> qwen3:4b        (~2.6 GB)  llama3.2:3b (~2.0 GB)
#   8 GB VRAM  -> qwen3:8b        (~5.2 GB)
#   16 GB VRAM -> qwen3:14b, mistral-nemo:12b
# Install:  ollama pull qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
# Local models in failover order. Measured on a 4 GB card against the planner's real
# schema, which is the only benchmark that matters here - a model that handles a toy
# schema can still return an empty object on the real one:
#   qwen3:4b       2.5 GB  best quality, 17s     - start here
#   qwen3:1.7b     1.4 GB  fastest usable, 8s    - the workhorse when 4b is busy
#   granite4.1:3b  2.1 GB  binds tools, but returns EMPTY on the planner schema
#   llama3.2:3b    2.0 GB  binds tools, but returns EMPTY on the planner schema
# The last two are kept only as a final fallback ahead of failing outright.
# Optional, with ~6 GB of free RAM and patience: append qwen3:8b (5.2 GB), the best
# local quality, but it runs partly on CPU on a 4 GB card.
# Install:  ollama pull qwen3:4b   (repeat per model)
OLLAMA_MODELS=qwen3:4b,qwen3:1.7b,granite4.1:3b,llama3.2:3b

# Context window for local models. A window larger than the GPU can hold spills the KV
# cache into system RAM: the same 4B model that answered in 17s at 16K took 371s at 64K.
OLLAMA_NUM_CTX=16384

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=90
LLM_RATE_LIMIT_RPM=25

# Small models intermittently return an empty object from a large structured-output
# call. The agents retry the extraction this many times before accepting one.
LLM_EXTRACTION_ATTEMPTS=3

# ------------------------------------------------------------------------------
# Web search (REQUIRED - the assignment's mandatory research tool)
# ------------------------------------------------------------------------------
SEARCH_PROVIDER=serper              # serper | exa

# Serper - 2,500 free queries on signup. https://serper.dev/api-key
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev

# Exa - 1,000 free searches/month. https://dashboard.exa.ai/api-keys
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

SEARCH_RESULTS_PER_QUERY=6
SEARCH_MAX_QUERIES_PER_RUN=6

# ------------------------------------------------------------------------------
# Keyless external APIs (no signup required)
# ------------------------------------------------------------------------------
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
FORECAST_HORIZON_DAYS=16            # beyond this, fall back to climate normals
CLIMATE_NORMAL_YEARS=5              # years of history averaged for normals

FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1

# ------------------------------------------------------------------------------
# Workflow
# ------------------------------------------------------------------------------
MAX_REVISIONS=3                     # reject/revise cycles before forced finalisation
AGENT_MAX_TOOL_ITERATIONS=16
MAX_TRIP_DAYS=30                    # input validation ceiling
MAX_TRAVELERS=20
PROMPT_VERSION=v1                   # selects prompts/templates/<agent>/<version>.j2

# ------------------------------------------------------------------------------
# Budget allocation ratios - must sum to 1.0 (validated at startup)
# ------------------------------------------------------------------------------
BUDGET_RATIO_LODGING=0.40
BUDGET_RATIO_FOOD=0.25
BUDGET_RATIO_ACTIVITIES=0.20
BUDGET_RATIO_TRANSPORT=0.10
BUDGET_RATIO_CONTINGENCY=0.05

# Share of the budget shifted into a category the traveller's interests emphasise,
# taken from lodging. Set to 0 to keep the split fixed regardless of interests.
BUDGET_EMPHASIS_SHIFT=0.05

# Day pacing thresholds used by the itinerary feasibility check. A day scheduling
# fewer than the minimum hours reads as thin; more than the maximum is exhausting.
DAY_MIN_SCHEDULED_HOURS=3.0
DAY_MAX_SCHEDULED_HOURS=9.0

# Distinct neighbourhoods a single day may span before cross-town transit starts
# eating the day.
DAY_MAX_NEIGHBOURHOODS=3

# ------------------------------------------------------------------------------
# Persistence
#
# DATABASE_URL holds plan records and the HITL audit trail.
# CHECKPOINT_DB_PATH holds LangGraph checkpoints - this is what lets the workflow
# survive the human-in-the-loop pause across separate HTTP requests.
# For Postgres: postgresql+asyncpg://user:pass@host/db (also swap the checkpointer
# package to langgraph-checkpoint-postgres).
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/itinera.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# ------------------------------------------------------------------------------
# Caching - protects scarce free-tier quota across restarts and revision loops
# ------------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_DIR=./data/cache
CACHE_MEMORY_MAXSIZE=512
CACHE_TTL_SEARCH_SECONDS=86400      # 24h  - destination facts move slowly
CACHE_TTL_FORECAST_SECONDS=10800    # 3h   - forecasts are refreshed hourly upstream
CACHE_TTL_CLIMATE_SECONDS=2592000   # 30d  - climate normals are effectively static
CACHE_TTL_FX_SECONDS=43200          # 12h  - ECB publishes once per working day
CACHE_TTL_LLM_SECONDS=0             # 0 disables LLM response caching

# ------------------------------------------------------------------------------
# TLS
#
# Verify certificates against the operating system's trust store rather than the
# certifi bundle. Required on machines behind TLS inspection - corporate proxies,
# VPN clients and some antivirus products re-sign traffic with a private root that
# the OS trusts and certifi does not, which otherwise fails every outbound call
# with CERTIFICATE_VERIFY_FAILED. Harmless elsewhere. Set to false only if your
# deployment needs the bundled authorities instead.
# ------------------------------------------------------------------------------
SSL_USE_SYSTEM_TRUST_STORE=true

# ------------------------------------------------------------------------------
# Resilience
# ------------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_BACKOFF_MAX_SECONDS=8.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
